# Copy to .env for local development. Set real values in the Render dashboard.
# Required from Phase 2: CLIENT_URL, MONGODB_URI, GOOGLE_CLIENT_ID and the three secrets.
# Generate each secret with: openssl rand -hex 32  (use different values in production)

NODE_ENV=development
PORT=5050

# The Next.js site (used for CORS, the CSRF Origin check and revalidation calls)
CLIENT_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated (e.g. a Vercel preview URL)
CORS_ORIGINS=
# Proxies in front of the API: Render = 1. With the Vercel /api/v1 proxy in front, use 2 so
# rate limits see the visitor's IP (check req IPs in Render logs after deploying).
TRUST_PROXY_HOPS=1

# Phase 2 — database & auth
MONGODB_URI=
# Leave empty while the client proxies /api/v1 (default). Set to .<domain> only when the
# browser calls api.<domain> directly.
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=krunalbhandekar10@gmail.com
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REVALIDATE_SECRET=

# Phase 3 — media
# Cloudinary dashboard → API Keys → "API environment variable"
CLOUDINARY_URL=

# Phase 4 — contact & monitoring
RESEND_API_KEY=
# Sender; onboarding@resend.dev works without a domain but only delivers to your Resend account email
RESEND_FROM=Portfolio <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=krunalbhandekar10@gmail.com
SENTRY_DSN=

# Phase 6 — GitHub & scheduled jobs
GITHUB_TOKEN=
JOBS_SECRET=
