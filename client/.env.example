# Copy to .env.local for local development. Set real values in the Vercel dashboard.

# Public URL of this site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API origin, server-side only (no trailing slash, no /api/v1).
# Browser requests to /api/v1/* are proxied here so auth cookies stay first-party.
# Local: http://localhost:5050   Production: your Render URL, e.g. https://portfolio-api.onrender.com
API_URL=http://localhost:5050

# Optional: call the API directly from the browser instead of through the proxy.
# Only use with a shared custom domain (api.<domain>) and COOKIE_DOMAIN set on the server.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Google OAuth client ID (Phase 2)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudinary cloud name, public (Phase 3)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare Turnstile site key (Phase 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret the server uses to call /api/revalidate (Phase 2), must match server REVALIDATE_SECRET
REVALIDATE_SECRET=

# Sentry DSN (Phase 4)
NEXT_PUBLIC_SENTRY_DSN=
